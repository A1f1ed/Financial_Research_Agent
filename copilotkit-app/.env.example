# Local single-user app. Keys can also be entered in Settings > AI settings.
AGENT_URL=http://127.0.0.1:8123

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Initial model before a provider is selected and saved in the UI.
# Examples: openai:qwen3.8-flash, openai:deepseek-flash, openai:glm-5.3
COPILOTKIT_AGENT_MODEL=openai:qwen3.8-flash
QWEN_ENABLE_THINKING=true

# Optional: point at an already authorized Longbridge CLI and custom data directory.
# LONGBRIDGE_CLI_PATH=
# RESEARCH_DATA_DIR=

# Optional CopilotKit Intelligence: native thread history, tracing and learning.
# Use your own endpoint URLs and key. Rebuild the UI after changing integration flags.
# CPK_INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=copilotkit-tasks

# Optional metadata-only Langfuse tracing (the URL must match your project's region).
# Prompts, documents, outputs and reasoning are not exported by this integration.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
APERTURE_TRACING_ENABLED=true
