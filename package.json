{
  "name": "folio-research",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:agent": ".venv/bin/python -m uvicorn backend.server:app --host 0.0.0.0 --port 8000",
    "setup:agent": "node scripts/setup-agent.mjs",
    "test:agent": ".venv/bin/python -m pytest backend/tests -q",
    "build": "next build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.2",
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/react-ui": "1.83.0",
    "@copilotkit/runtime": "1.83.0",
    "ai": "^7.0.159",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "swr": "^2.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
