# Generate infra/.env with scripts/init_infra.py. Do not reuse these placeholders.
POSTGRES_USER=aperture
POSTGRES_DB=aperture
POSTGRES_PASSWORD=replace-with-generated-secret
RABBITMQ_USER=aperture
RABBITMQ_PASSWORD=replace-with-generated-secret
REDIS_PASSWORD=replace-with-generated-secret
NEO4J_PASSWORD=replace-with-generated-secret
S3_ACCESS_KEY=replace-with-generated-id
S3_SECRET_KEY=replace-with-generated-secret
S3_BUCKET=aperture-research
DATABASE_URL=postgresql+psycopg://aperture:replace-with-generated-secret@127.0.0.1:15432/aperture
CHECKPOINT_DATABASE_URL=postgresql://aperture:replace-with-generated-secret@127.0.0.1:15432/aperture
CELERY_BROKER_URL=amqp://aperture:replace-with-generated-secret@127.0.0.1:15673/aperture
REDIS_URL=redis://:replace-with-generated-secret@127.0.0.1:16379/0
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
S3_ENDPOINT_URL=http://127.0.0.1:18333
S3_REGION=us-east-1
RESEARCH_SCHEDULER_ENABLED=false
